# Variables de entorno — copia este archivo a .env y completa los valores
# NO subas el archivo .env al repositorio

# Google OAuth 2.0 Client ID
# Más info: https://console.cloud.google.com/ → APIs y servicios → Credenciales
# El login usa Google Identity Services: el boton entrega un ID token firmado
# que el servidor valida en POST /auth/google. No hace falta client secret.
# Nunca pongas un secreto con prefijo VITE_: se incrusta en el bundle publico.
VITE_GOOGLE_CLIENT_ID=
