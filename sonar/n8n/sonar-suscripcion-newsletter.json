    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst rawName = (body.name || 'Amante del Sonido').trim();\nconst name = rawName.includes('@') ? rawName.split('@')[0] : rawName;\nconst topics = Array.isArray(body.topics) && body.topics.length > 0 ? body.topics.join(', ') : 'Lanzamientos en Vinilo, Noticias Audiófilas y Reseñas Hi-Fi';\n\nreturn [\n  {\n    json: {\n      email,\n      name,\n      topics,\n      subscribedAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "93eb53a1-125c-43f6-95b7-789a7413cfbf",
      "name": "Procesar Suscripción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "¡Bienvenido a SONAR Weekly! Tu dosis de alta fidelidad",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR Weekly - Boletín Audiófilo</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #231123; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #DCDCDD;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #231123; padding: 36px 14px;\">\n    <tr>\n      <td align=\"center\">\n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 540px; background-color: #4B2840; border: 1px solid rgba(220,220,221,0.18); border-radius: 20px; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.6);\">\n          <!-- Cabecera con Isotipo Oficial SONAR -->\n          <tr>\n            <td align=\"center\" style=\"padding: 38px 24px 22px; background: linear-gradient(180deg, rgba(0,56,68,0.35) 0%, rgba(75,40,64,0) 100%);\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 0 auto; text-align: center;\">\n                <tr>\n                  <td align=\"center\" style=\"padding-bottom: 12px;\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 120\" width=\"78\" height=\"78\" fill=\"none\" style=\"display: block; margin: 0 auto;\">\n                      <defs>\n                        <radialGradient id=\"topPetalNews\" cx=\"50%\" cy=\"35%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#9E1B29\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#4A0E18\" stop-opacity=\"0.8\" />\n                        </radialGradient>\n                        <radialGradient id=\"leftPetalNews\" cx=\"35%\" cy=\"50%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#C51613\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#6B0907\" stop-opacity=\"0.8\" />\n                        </radialGradient>\n                        <radialGradient id=\"bottomPetalNews\" cx=\"50%\" cy=\"65%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#1B324B\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#0E1A29\" stop-opacity=\"0.85\" />\n                        </radialGradient>\n                        <radialGradient id=\"rightPetalNews\" cx=\"65%\" cy=\"50%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#4B2A5E\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#231130\" stop-opacity=\"0.85\" />\n                        </radialGradient>\n                      </defs>\n                      <g>\n                        <circle cx=\"60\" cy=\"38\" r=\"27\" fill=\"url(#topPetalNews)\" />\n                        <circle cx=\"38\" cy=\"60\" r=\"27\" fill=\"url(#leftPetalNews)\" />\n                        <circle cx=\"60\" cy=\"82\" r=\"27\" fill=\"url(#bottomPetalNews)\" />\n                        <circle cx=\"82\" cy=\"60\" r=\"27\" fill=\"url(#rightPetalNews)\" />\n                      </g>\n                      <circle cx=\"60\" cy=\"60\" r=\"37\" stroke=\"rgba(255, 255, 255, 0.45)\" stroke-width=\"1.2\" stroke-dasharray=\"3.5 3.5\" fill=\"none\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"21\" stroke=\"rgba(255, 255, 255, 0.55)\" stroke-width=\"1\" fill=\"none\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"11\" fill=\"#1C0D1C\" stroke=\"rgba(255, 255, 255, 0.25)\" stroke-width=\"1\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"7.5\" fill=\"#B80C09\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"2.8\" fill=\"#ffffff\" />\n                    </svg>\n                  </td>\n                </tr>\n                <tr>\n                  <td align=\"center\">\n                    <div style=\"display: inline-block; background: #231123; border: 1.5px solid #003844; border-radius: 50px; padding: 6px 20px; text-align: center;\">\n                      <span style=\"font-size: 19px; font-weight: 900; letter-spacing: 5px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n                      <span style=\"font-size: 9px; font-weight: 700; color: #DCDCDD; letter-spacing: 2.5px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid rgba(220,220,221,0.3); vertical-align: middle;\">WEEKLY</span>\n                    </div>\n                  </td>\n                </tr>\n              </table>\n              <h1 style=\"color: #ffffff; font-size: 24px; font-weight: 800; margin: 24px 0 6px;\">¡Estás dentro de la comunidad!</h1>\n              <p style=\"color: #DCDCDD; font-size: 14px; margin: 0; opacity: 0.9;\">Hola <strong style=\"color: #ffffff;\">{{ $json.name }}</strong>, gracias por unirte a SONAR Weekly.</p>\n            </td>\n          </tr>\n\n          <!-- Contenido Principal -->\n          <tr>\n            <td style=\"padding: 10px 32px 30px;\">\n              <p style=\"font-size: 14px; line-height: 1.6; color: #DCDCDD; margin: 0 0 16px;\">\n                Cada semana recibirás reseñas de ediciones limitadas en vinilo, noticias de la industria y comparativas de audio analógico vs digital.\n              </p>\n\n              <div style=\"background: #231123; border-left: 3px solid #003844; border-radius: 8px; padding: 14px 16px; margin: 16px 0;\">\n                <div style=\"font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #DCDCDD; opacity: 0.8; margin-bottom: 4px;\">Tus preferencias:</div>\n                <div style=\"font-size: 13px; color: #ffffff;\">{{ $json.topics }}</div>\n              </div>\n            </td>\n          </tr>\n\n          <!-- Pie de página -->\n          <tr>\n            <td style=\"background-color: #231123; border-top: 1px solid rgba(220,220,221,0.15); padding: 22px 28px; text-align: center;\">\n              <p style=\"font-size: 11px; color: #DCDCDD; opacity: 0.5; margin: 0;\">\n                © 2026 SONAR High-Fidelity Audio • Boletín Semanal\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
