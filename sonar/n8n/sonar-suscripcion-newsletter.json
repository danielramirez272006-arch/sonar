    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst name = (body.name || 'Amante del Sonido').trim();\nconst topics = Array.isArray(body.topics) && body.topics.length > 0 ? body.topics.join(', ') : 'Lanzamientos en Vinilo, Noticias Audiófilas y Reseñas Hi-Fi';\n\nreturn [\n  {\n    json: {\n      email,\n      name,\n      topics,\n      subscribedAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "93eb53a1-125c-43f6-95b7-789a7413cfbf",
      "name": "Procesar Suscripción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "🎷 ¡Bienvenido a SONAR Weekly! Tu dosis de alta fidelidad",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR Weekly - Boletín Audiófilo</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #0c0a09; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f4f4f5;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px; margin: 30px auto; background-color: #18181b; border: 1px solid #27272a; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.6);\">\n    <!-- Header con Logo SONAR -->\n    <tr>\n      <td align=\"center\" style=\"padding: 36px 20px 20px; background: linear-gradient(180deg, rgba(184,12,9,0.18) 0%, rgba(24,24,27,0) 100%);\">\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"display: inline-block;\">\n          <tr>\n            <td style=\"background: #09090b; border: 1px solid #B80C09; border-radius: 50px; padding: 10px 24px; text-align: center;\">\n              <span style=\"display: inline-block; width: 12px; height: 12px; background: #B80C09; border-radius: 50%; margin-right: 8px; vertical-align: middle; box-shadow: 0 0 10px #B80C09;\"></span>\n              <span style=\"font-size: 22px; font-weight: 900; letter-spacing: 4px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n              <span style=\"font-size: 11px; font-weight: 700; color: #ec4899; letter-spacing: 2px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid #3f3f46; vertical-align: middle;\">WEEKLY</span>\n            </td>\n          </tr>\n        </table>\n        <h1 style=\"color: #ffffff; font-size: 22px; font-weight: 800; margin: 24px 0 6px;\">¡Estás dentro, {{ $json.name }}!</h1>\n        <p style=\"color: #a1a1aa; font-size: 14px; margin: 0;\">Gracias por unirte a la comunidad SONAR.</p>\n      </td>\n    </tr>\n\n    <!-- Contenido Principal -->\n    <tr>\n      <td style=\"padding: 10px 36px 30px;\">\n        <p style=\"font-size: 15px; line-height: 1.6; color: #d4d4d8;\">\n          Cada viernes recibirás en tu bandeja los lanzamientos más esperados en formato vinilo, análisis de audio analógico vs digital, y noticias del ecosistema SONAR.\n        </p>\n\n        <div style=\"background: #09090b; border-left: 4px solid #B80C09; border-radius: 6px; padding: 16px; margin: 20px 0;\">\n          <div style=\"font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #B80C09; margin-bottom: 4px;\">Tus intereses seleccionados:</div>\n          <div style=\"font-size: 14px; color: #e4e4e7;\">{{ $json.topics }}</div>\n        </div>\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"background-color: #09090b; border-top: 1px solid #27272a; padding: 24px 36px; text-align: center;\">\n        <p style=\"font-size: 12px; color: #71717a; margin: 0 0 8px;\">\n          Has recibido este correo porque te suscribiste desde <span style=\"color: #f43f5e;\">{{ $json.email }}</span>.\n        </p>\n        <p style=\"font-size: 11px; color: #52525b; margin: 0;\">\n          © 2026 SONAR High-Fidelity Audio • Todos los derechos reservados.\n        </p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
