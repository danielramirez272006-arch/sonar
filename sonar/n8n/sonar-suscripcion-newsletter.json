    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst rawName = (body.name || 'Amante del Sonido').trim();\nconst name = rawName.includes('@') ? rawName.split('@')[0] : rawName;\nconst topics = Array.isArray(body.topics) && body.topics.length > 0 ? body.topics.join(', ') : 'Lanzamientos en Vinilo, Noticias Audiófilas y Reseñas Hi-Fi';\n\nreturn [\n  {\n    json: {\n      email,\n      name,\n      topics,\n      subscribedAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "93eb53a1-125c-43f6-95b7-789a7413cfbf",
      "name": "Procesar Suscripción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "¡Bienvenido a SONAR Weekly! Tu dosis de alta fidelidad",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR Weekly - Boletín Audiófilo</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #09090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f4f4f5;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #09090b; padding: 32px 12px;\">\n    <tr>\n      <td align=\"center\">\n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 540px; background: #141418; border: 1px solid #27272a; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.8);\">\n          <!-- Cabecera con Logo SONAR -->\n          <tr>\n            <td align=\"center\" style=\"padding: 36px 24px 20px; background: radial-gradient(circle at top, rgba(236,72,153,0.18) 0%, rgba(20,20,24,0) 75%);\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 0 auto;\">\n                <tr>\n                  <td style=\"background: #09090b; border: 1px solid rgba(255,255,255,0.15); border-radius: 50px; padding: 8px 22px; text-align: center;\">\n                    <span style=\"display: inline-block; width: 10px; height: 10px; background: #ec4899; border-radius: 50%; margin-right: 8px; vertical-align: middle; box-shadow: 0 0 10px #ec4899;\"></span>\n                    <span style=\"font-size: 20px; font-weight: 900; letter-spacing: 4px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n                    <span style=\"font-size: 10px; font-weight: 700; color: #ec4899; letter-spacing: 2px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid #3f3f46; vertical-align: middle;\">WEEKLY</span>\n                  </td>\n                </tr>\n              </table>\n              <h1 style=\"color: #ffffff; font-size: 23px; font-weight: 800; margin: 24px 0 6px;\">¡Estás dentro de la comunidad!</h1>\n              <p style=\"color: #a1a1aa; font-size: 14px; margin: 0;\">Hola <span style=\"color: #ffffff; font-weight: 700;\">{{ $json.name }}</span>, gracias por unirte a SONAR Weekly.</p>\n            </td>\n          </tr>\n\n          <!-- Contenido Principal -->\n          <tr>\n            <td style=\"padding: 10px 32px 30px;\">\n              <p style=\"font-size: 14px; line-height: 1.6; color: #d4d4d8; margin: 0 0 16px;\">\n                Cada semana recibirás reseñas de ediciones limitadas en vinilo, noticias de la industria y comparativas de audio analógico vs digital.\n              </p>\n\n              <div style=\"background: #09090b; border-left: 3px solid #ec4899; border-radius: 8px; padding: 14px 16px; margin: 16px 0;\">\n                <div style=\"font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #f472b6; margin-bottom: 4px;\">Tus preferencias:</div>\n                <div style=\"font-size: 13px; color: #f4f4f5;\">{{ $json.topics }}</div>\n              </div>\n            </td>\n          </tr>\n\n          <!-- Pie de página -->\n          <tr>\n            <td style=\"background-color: #09090b; border-top: 1px solid #27272a; padding: 22px 28px; text-align: center;\">\n              <p style=\"font-size: 11px; color: #52525b; margin: 0;\">\n                © 2026 SONAR High-Fidelity Audio • Boletín Semanal\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
