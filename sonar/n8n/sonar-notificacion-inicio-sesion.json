{
  "name": "SONAR - Alerta de Inicio de Sesión",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "login-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "log-webhook-001",
      "name": "Webhook Inicio de Sesión",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "login-alert"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-email-log-01",
              "leftValue": "={{ $json.body?.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "log-val-email-002",
      "name": "Validar Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": false,\n  \"message\": \"No se proporcionó un correo válido para la notificación.\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "log-err-003",
      "name": "Respuesta Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst username = (body.username || 'Usuario').trim();\nconst device = body.device || 'Navegador Web';\nconst timestamp = body.timestamp || new Date().toISOString();\nconst dateFormatted = new Date(timestamp).toLocaleString('es-ES', { timeZone: 'America/Mexico_City', dateStyle: 'full', timeStyle: 'medium' });\n\nreturn [{\n  json: {\n    email,\n    username,\n    device,\n    timestamp,\n    dateFormatted,\n    subject: `🔐 [SONAR] Nuevo inicio de sesión detectado en tu cuenta`\n  }\n}];"
      },
      "id": "log-prep-004",
      "name": "Formatear Datos de Seguridad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR - Alerta de Inicio de Sesión</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #0c0a09; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f4f4f5;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px; margin: 30px auto; background-color: #18181b; border: 1px solid #27272a; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.6);\">\n    <!-- Header con Logo SONAR -->\n    <tr>\n      <td align=\"center\" style=\"padding: 36px 20px 20px; background: linear-gradient(180deg, rgba(184,12,9,0.18) 0%, rgba(24,24,27,0) 100%);\">\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"display: inline-block;\">\n          <tr>\n            <td style=\"background: #09090b; border: 1px solid #B80C09; border-radius: 50px; padding: 10px 24px; text-align: center;\">\n              <span style=\"display: inline-block; width: 12px; height: 12px; background: #B80C09; border-radius: 50%; margin-right: 8px; vertical-align: middle; box-shadow: 0 0 10px #B80C09;\"></span>\n              <span style=\"font-size: 22px; font-weight: 900; letter-spacing: 4px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n              <span style=\"font-size: 11px; font-weight: 700; color: #10b981; letter-spacing: 2px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid #3f3f46; vertical-align: middle;\">SEGURIDAD</span>\n            </td>\n          </tr>\n        </table>\n        <h1 style=\"color: #ffffff; font-size: 22px; font-weight: 800; margin: 24px 0 6px;\">Inicio de Sesión en SONAR</h1>\n        <p style=\"color: #a1a1aa; font-size: 14px; margin: 0;\">Hola {{ $json.username }}, se acaba de iniciar sesión en tu cuenta.</p>\n      </td>\n    </tr>\n\n    <!-- Contenido Principal -->\n    <tr>\n      <td style=\"padding: 10px 36px 30px;\">\n        <p style=\"font-size: 15px; line-height: 1.6; color: #d4d4d8;\">\n          Te confirmamos que se ha iniciado sesión en SONAR con tu correo electrónico registrado:\n        </p>\n\n        <!-- Ficha de Detalles de Sesión -->\n        <div style=\"background: #09090b; border: 1px solid #3f3f46; border-radius: 12px; padding: 20px; margin: 20px 0;\">\n          <table width=\"100%\" border=\"0\" cellpadding=\"6\" cellspacing=\"0\">\n            <tr>\n              <td width=\"35%\" style=\"font-size: 13px; color: #a1a1aa; font-weight: 600;\">👤 Usuario:</td>\n              <td style=\"font-size: 14px; color: #ffffff; font-weight: 700;\">{{ $json.username }}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size: 13px; color: #a1a1aa; font-weight: 600;\">✉️ Correo:</td>\n              <td style=\"font-size: 14px; color: #ffffff;\">{{ $json.email }}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size: 13px; color: #a1a1aa; font-weight: 600;\">🖥️ Dispositivo / Navegador:</td>\n              <td style=\"font-size: 13px; color: #38bdf8; font-family: monospace;\">{{ $json.device }}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size: 13px; color: #a1a1aa; font-weight: 600;\">⏰ Fecha y Hora:</td>\n              <td style=\"font-size: 13px; color: #e4e4e7;\">{{ $json.dateFormatted }}</td>\n            </tr>\n          </table>\n        </div>\n\n        <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background: rgba(184, 12, 9, 0.12); border: 1px solid rgba(184, 12, 9, 0.4); border-radius: 8px; padding: 14px; margin: 20px 0;\">\n          <tr>\n            <td style=\"font-size: 13px; color: #fca5a5; line-height: 1.5;\">\n              ⚠️ <strong>¿No fuiste tú?</strong> Si no reconoces esta actividad, te recomendamos ingresar inmediatamente a SONAR, cambiar tu contraseña y revisar el control parental o perfiles activos.\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"background-color: #09090b; border-top: 1px solid #27272a; padding: 24px 36px; text-align: center;\">\n        <p style=\"font-size: 12px; color: #71717a; margin: 0 0 8px;\">\n          Notificación automática de seguridad para <span style=\"color: #f43f5e;\">{{ $json.email }}</span>.\n        </p>\n        <p style=\"font-size: 11px; color: #52525b; margin: 0;\">\n          © 2026 SONAR High-Fidelity Music System • Control Parental & Experiencia Audiófila\n        </p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
      "id": "log-send-gmail-005",
      "name": "Enviar Alerta con Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
