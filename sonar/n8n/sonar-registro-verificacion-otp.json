    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-email-01",
              "leftValue": "={{ $json.body?.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "reg-val-email-002",
      "name": "Validar Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": false,\n  \"message\": \"Debes proporcionar un correo electrónico válido para registrarte.\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "reg-err-003",
      "name": "Respuesta Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst rawName = (body.username || 'Melómano').trim();\n// Si el username viene con email, extraer la parte antes del @\nconst username = rawName.includes('@') ? rawName.split('@')[0] : rawName;\nconst code = body.code ? String(body.code) : Math.floor(100000 + Math.random() * 900000).toString();\nconst dateFormatted = new Date().toLocaleString('es-ES', { timeZone: 'America/Mexico_City', dateStyle: 'long', timeStyle: 'short' });\n\nreturn [{\n  json: {\n    email,\n    username,\n    code,\n    dateFormatted,\n    subject: `Tu código de activación SONAR: ${code}`\n  }\n}];"
      },
      "id": "reg-prep-004",
      "name": "Preparar Código y Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR - Verificación de Cuenta</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #09090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f4f4f5;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #09090b; padding: 32px 12px;\">\n    <tr>\n      <td align=\"center\">\n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 540px; background: #141418; border: 1px solid #27272a; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.8);\">\n          <!-- Cabecera con Logo SONAR -->\n          <tr>\n            <td align=\"center\" style=\"padding: 36px 24px 20px; background: radial-gradient(circle at top, rgba(184,12,9,0.22) 0%, rgba(20,20,24,0) 75%);\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 0 auto;\">\n                <tr>\n                  <td style=\"background: #09090b; border: 1px solid rgba(255,255,255,0.15); border-radius: 50px; padding: 8px 22px; text-align: center;\">\n                    <span style=\"display: inline-block; width: 10px; height: 10px; background: #B80C09; border-radius: 50%; margin-right: 8px; vertical-align: middle; box-shadow: 0 0 10px #B80C09;\"></span>\n                    <span style=\"font-size: 20px; font-weight: 900; letter-spacing: 4px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n                    <span style=\"font-size: 10px; font-weight: 700; color: #f43f5e; letter-spacing: 2px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid #3f3f46; vertical-align: middle;\">HI-FI</span>\n                  </td>\n                </tr>\n              </table>\n              <h1 style=\"color: #ffffff; font-size: 23px; font-weight: 800; margin: 24px 0 6px; letter-spacing: -0.5px;\">¡Bienvenido a SONAR!</h1>\n              <p style=\"color: #a1a1aa; font-size: 14px; margin: 0; line-height: 1.5;\">Hola <span style=\"color: #ffffff; font-weight: 700;\">{{ $json.username }}</span>, estás a un paso de activar tu radar audiófilo.</p>\n            </td>\n          </tr>\n\n          <!-- Bloque del Código OTP -->\n          <tr>\n            <td style=\"padding: 10px 32px 30px;\">\n              <p style=\"font-size: 14px; line-height: 1.6; color: #d4d4d8; text-align: center; margin: 0 0 20px;\">\n                Ingresa el siguiente código de seguridad en la pantalla de registro para validar tu correo y elegir tu contraseña:\n              </p>\n\n              <!-- Código Box -->\n              <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 20px 0;\">\n                <tr>\n                  <td align=\"center\" style=\"background: #09090b; border: 1.5px solid #B80C09; border-radius: 14px; padding: 22px 16px; text-align: center; box-shadow: 0 0 30px rgba(184, 12, 9, 0.2);\">\n                    <div style=\"font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 2.5px; color: #f43f5e; margin-bottom: 6px;\">Tu Código de Activación</div>\n                    <div style=\"font-family: 'SF Mono', Monaco, 'Courier New', Courier, monospace; font-size: 42px; font-weight: 900; letter-spacing: 12px; color: #ffffff; padding-left: 12px; text-shadow: 0 0 15px rgba(255,255,255,0.4);\">\n                      {{ $json.code }}\n                    </div>\n                    <div style=\"font-size: 11px; color: #71717a; margin-top: 8px;\">⏱️ Válido durante 15 minutos</div>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Beneficios -->\n              <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background: #1c1c22; border: 1px solid #2e2e38; border-radius: 10px; padding: 14px 18px; margin: 18px 0 0;\">\n                <tr>\n                  <td style=\"font-size: 13px; color: #e4e4e7; line-height: 1.5;\">\n                    🛡️ <strong>Siguiente paso:</strong> Al introducir este código, podrás establecer la contraseña personalizada que prefieras y comenzar a explorar catálogos de vinilo y reseñas de audio.\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Pie de página -->\n          <tr>\n            <td style=\"background-color: #09090b; border-top: 1px solid #27272a; padding: 22px 28px; text-align: center;\">\n              <p style=\"font-size: 11px; color: #71717a; margin: 0 0 6px;\">\n                Si no solicitaste este registro, puedes ignorar este correo de forma segura.\n              </p>\n              <p style=\"font-size: 11px; color: #52525b; margin: 0;\">\n                © 2026 SONAR Music Ecosystem • High-Fidelity Audio Experience\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
      "id": "reg-send-gmail-005",
      "name": "Enviar Código con Gmail",
      "type": "n8n-nodes-base.gmail",
