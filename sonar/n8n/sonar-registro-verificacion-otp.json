    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR - Verificación de Cuenta</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #231123; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #DCDCDD;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #231123; padding: 36px 14px;\">\n    <tr>\n      <td align=\"center\">\n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 540px; background-color: #4B2840; border: 1px solid rgba(220,220,221,0.18); border-radius: 20px; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.6);\">\n          <!-- Cabecera con Logo SONAR -->\n          <tr>\n            <td align=\"center\" style=\"padding: 38px 24px 22px; background: linear-gradient(180deg, rgba(184,12,9,0.25) 0%, rgba(75,40,64,0) 100%);\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 0 auto;\">\n                <tr>\n                  <td style=\"background: #231123; border: 1.5px solid #B80C09; border-radius: 50px; padding: 8px 22px; text-align: center;\">\n                    <span style=\"display: inline-block; width: 10px; height: 10px; background: #B80C09; border-radius: 50%; margin-right: 8px; vertical-align: middle; box-shadow: 0 0 10px #B80C09;\"></span>\n                    <span style=\"font-size: 20px; font-weight: 900; letter-spacing: 4px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n                    <span style=\"font-size: 10px; font-weight: 700; color: #DCDCDD; letter-spacing: 2px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid rgba(220,220,221,0.3); vertical-align: middle;\">HI-FI</span>\n                  </td>\n                </tr>\n              </table>\n              <h1 style=\"color: #ffffff; font-size: 24px; font-weight: 800; margin: 24px 0 6px;\">¡Bienvenido a SONAR!</h1>\n              <p style=\"color: #DCDCDD; font-size: 14px; margin: 0; opacity: 0.9;\">Hola <strong style=\"color: #ffffff;\">{{ $json.username }}</strong>, activa tu radar de audio de alta fidelidad.</p>\n            </td>\n          </tr>\n\n          <!-- Bloque del Código OTP -->\n          <tr>\n            <td style=\"padding: 10px 32px 30px;\">\n              <p style=\"font-size: 14px; line-height: 1.6; color: #DCDCDD; text-align: center; margin: 0 0 18px;\">\n                Ingresa el siguiente código de 6 dígitos en la página de registro para confirmar tu correo y establecer tu contraseña:\n              </p>\n\n              <!-- Código Box Oficial -->\n              <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 18px 0;\">\n                <tr>\n                  <td align=\"center\" style=\"background: #231123; border: 2px solid #B80C09; border-radius: 14px; padding: 22px 16px; text-align: center; box-shadow: 0 8px 24px rgba(184, 12, 9, 0.25);\">\n                    <div style=\"font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 2.5px; color: #B80C09; margin-bottom: 6px;\">Código de Activación</div>\n                    <div style=\"font-family: 'SF Mono', Monaco, 'Courier New', Courier, monospace; font-size: 42px; font-weight: 900; letter-spacing: 12px; color: #ffffff; padding-left: 12px; text-shadow: 0 0 15px rgba(255,255,255,0.3);\">\n                      {{ $json.code }}\n                    </div>\n                    <div style=\"font-size: 11px; color: #DCDCDD; opacity: 0.75; margin-top: 8px;\">⏱️ Válido durante 15 minutos</div>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Panel Informativo Acento Teal -->\n              <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background: #003844; border-radius: 10px; padding: 14px 18px; margin: 18px 0 0;\">\n                <tr>\n                  <td style=\"font-size: 13px; color: #ffffff; line-height: 1.5;\">\n                    🛡️ <strong>Seguridad Audiófila:</strong> Al verificar este código, podrás elegir una contraseña segura y disfrutar del catálogo de vinilos y control parental.\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Pie de página -->\n          <tr>\n            <td style=\"background-color: #231123; border-top: 1px solid rgba(220,220,221,0.15); padding: 22px 28px; text-align: center;\">\n              <p style=\"font-size: 11px; color: #DCDCDD; opacity: 0.7; margin: 0 0 6px;\">\n                Si no solicitaste este registro en SONAR, puedes ignorar este mensaje.\n              </p>\n              <p style=\"font-size: 11px; color: #DCDCDD; opacity: 0.5; margin: 0;\">\n                © 2026 SONAR Music Ecosystem • Midnight Violet & Brick Ember Identity\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
