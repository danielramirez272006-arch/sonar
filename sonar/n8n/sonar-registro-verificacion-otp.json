    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst rawName = (body.username || 'Melómano').trim();\nconst username = rawName.includes('@') ? rawName.split('@')[0] : rawName;\nconst code = body.code ? String(body.code).padStart(6, '0') : Math.floor(100000 + Math.random() * 900000).toString();\nconst digits = code.split('');\nconst d1 = digits[0] || '0';\nconst d2 = digits[1] || '0';\nconst d3 = digits[2] || '0';\nconst d4 = digits[3] || '0';\nconst d5 = digits[4] || '0';\nconst d6 = digits[5] || '0';\nconst dateFormatted = new Date().toLocaleString('es-ES', { timeZone: 'America/Mexico_City', dateStyle: 'long', timeStyle: 'short' });\n\nreturn [{\n  json: {\n    email,\n    username,\n    code,\n    d1,\n    d2,\n    d3,\n    d4,\n    d5,\n    d6,\n    dateFormatted,\n    subject: `[SONAR] Tu código de activación: ${code}`\n  }\n}];"
      },
      "id": "reg-prep-004",
      "name": "Preparar Código y Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR - Verificación de Cuenta</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #1a0c1a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #DCDCDD;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #1a0c1a; padding: 36px 14px;\">\n    <tr>\n      <td align=\"center\">\n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 540px; background-color: #2e1628; border: 1px solid rgba(220,220,221,0.2); border-radius: 24px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.7);\">\n          <!-- Cabecera con Isotipo Oficial SONAR -->\n          <tr>\n            <td align=\"center\" style=\"padding: 38px 24px 20px; background: linear-gradient(180deg, rgba(184,12,9,0.3) 0%, rgba(46,22,40,0) 100%);\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 0 auto; text-align: center;\">\n                <tr>\n                  <td align=\"center\" style=\"padding-bottom: 12px;\">\n                    <!-- Isotipo Vectorial Oficial SONAR -->\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 120\" width=\"76\" height=\"76\" fill=\"none\" style=\"display: block; margin: 0 auto;\">\n                      <defs>\n                        <radialGradient id=\"topPetal\" cx=\"50%\" cy=\"35%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#9E1B29\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#4A0E18\" stop-opacity=\"0.8\" />\n                        </radialGradient>\n                        <radialGradient id=\"leftPetal\" cx=\"35%\" cy=\"50%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#C51613\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#6B0907\" stop-opacity=\"0.8\" />\n                        </radialGradient>\n                        <radialGradient id=\"bottomPetal\" cx=\"50%\" cy=\"65%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#1B324B\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#0E1A29\" stop-opacity=\"0.85\" />\n                        </radialGradient>\n                        <radialGradient id=\"rightPetal\" cx=\"65%\" cy=\"50%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#4B2A5E\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#231130\" stop-opacity=\"0.85\" />\n                        </radialGradient>\n                      </defs>\n                      <g>\n                        <circle cx=\"60\" cy=\"38\" r=\"27\" fill=\"url(#topPetal)\" />\n                        <circle cx=\"38\" cy=\"60\" r=\"27\" fill=\"url(#leftPetal)\" />\n                        <circle cx=\"60\" cy=\"82\" r=\"27\" fill=\"url(#bottomPetal)\" />\n                        <circle cx=\"82\" cy=\"60\" r=\"27\" fill=\"url(#rightPetal)\" />\n                      </g>\n                      <circle cx=\"60\" cy=\"60\" r=\"37\" stroke=\"rgba(255, 255, 255, 0.45)\" stroke-width=\"1.2\" stroke-dasharray=\"3.5 3.5\" fill=\"none\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"21\" stroke=\"rgba(255, 255, 255, 0.55)\" stroke-width=\"1\" fill=\"none\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"11\" fill=\"#1C0D1C\" stroke=\"rgba(255, 255, 255, 0.25)\" stroke-width=\"1\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"7.5\" fill=\"#B80C09\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"2.8\" fill=\"#ffffff\" />\n                    </svg>\n                  </td>\n                </tr>\n                <tr>\n                  <td align=\"center\">\n                    <div style=\"display: inline-block; background: #1C0D1C; border: 1.5px solid #003844; border-radius: 50px; padding: 6px 20px; text-align: center;\">\n                      <span style=\"font-size: 18px; font-weight: 900; letter-spacing: 5px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n                      <span style=\"font-size: 9px; font-weight: 700; color: #DCDCDD; letter-spacing: 2px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid rgba(220,220,221,0.3); vertical-align: middle;\">HI-FI AUDIO</span>\n                    </div>\n                  </td>\n                </tr>\n              </table>\n              <h1 style=\"color: #ffffff; font-size: 24px; font-weight: 800; margin: 22px 0 6px; letter-spacing: -0.5px;\">¡Bienvenido a SONAR!</h1>\n              <p style=\"color: #DCDCDD; font-size: 14px; margin: 0; opacity: 0.9;\">Hola <strong style=\"color: #ffffff;\">{{ $json.username }}</strong>, confirma tu cuenta para calibrar tu catálogo acústico.</p>\n            </td>\n          </tr>\n\n          <!-- Bloque del Código OTP Moderno -->\n          <tr>\n            <td style=\"padding: 10px 28px 28px;\">\n              <p style=\"font-size: 14px; line-height: 1.6; color: #DCDCDD; text-align: center; margin: 0 0 16px;\">\n                Ingresa el siguiente código de 6 dígitos en la aplicación para activar tu cuenta:\n              </p>\n\n              <!-- 6 Cápsulas de Dígitos de Alta Visibilidad -->\n              <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 16px auto 14px; width: 100%; max-width: 360px;\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 3px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"46\" style=\"background: #1C0D1C; border: 2px solid #B80C09; border-radius: 10px; box-shadow: 0 4px 14px rgba(184, 12, 9, 0.4);\">\n                      <tr>\n                        <td align=\"center\" valign=\"middle\" height=\"56\" style=\"font-family: 'SF Mono', Monaco, 'Courier New', monospace; font-size: 28px; font-weight: 900; color: #ffffff; text-align: center;\">\n                          {{ $json.d1 }}\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td align=\"center\" style=\"padding: 0 3px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"46\" style=\"background: #1C0D1C; border: 2px solid #B80C09; border-radius: 10px; box-shadow: 0 4px 14px rgba(184, 12, 9, 0.4);\">\n                      <tr>\n                        <td align=\"center\" valign=\"middle\" height=\"56\" style=\"font-family: 'SF Mono', Monaco, 'Courier New', monospace; font-size: 28px; font-weight: 900; color: #ffffff; text-align: center;\">\n                          {{ $json.d2 }}\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td align=\"center\" style=\"padding: 0 3px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"46\" style=\"background: #1C0D1C; border: 2px solid #B80C09; border-radius: 10px; box-shadow: 0 4px 14px rgba(184, 12, 9, 0.4);\">\n                      <tr>\n                        <td align=\"center\" valign=\"middle\" height=\"56\" style=\"font-family: 'SF Mono', Monaco, 'Courier New', monospace; font-size: 28px; font-weight: 900; color: #ffffff; text-align: center;\">\n                          {{ $json.d3 }}\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td align=\"center\" style=\"padding: 0 3px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"46\" style=\"background: #1C0D1C; border: 2px solid #B80C09; border-radius: 10px; box-shadow: 0 4px 14px rgba(184, 12, 9, 0.4);\">\n                      <tr>\n                        <td align=\"center\" valign=\"middle\" height=\"56\" style=\"font-family: 'SF Mono', Monaco, 'Courier New', monospace; font-size: 28px; font-weight: 900; color: #ffffff; text-align: center;\">\n                          {{ $json.d4 }}\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td align=\"center\" style=\"padding: 0 3px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"46\" style=\"background: #1C0D1C; border: 2px solid #B80C09; border-radius: 10px; box-shadow: 0 4px 14px rgba(184, 12, 9, 0.4);\">\n                      <tr>\n                        <td align=\"center\" valign=\"middle\" height=\"56\" style=\"font-family: 'SF Mono', Monaco, 'Courier New', monospace; font-size: 28px; font-weight: 900; color: #ffffff; text-align: center;\">\n                          {{ $json.d5 }}\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td align=\"center\" style=\"padding: 0 3px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"46\" style=\"background: #1C0D1C; border: 2px solid #B80C09; border-radius: 10px; box-shadow: 0 4px 14px rgba(184, 12, 9, 0.4);\">\n                      <tr>\n                        <td align=\"center\" valign=\"middle\" height=\"56\" style=\"font-family: 'SF Mono', Monaco, 'Courier New', monospace; font-size: 28px; font-weight: 900; color: #ffffff; text-align: center;\">\n                          {{ $json.d6 }}\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Bloque de Copia Rápida y Expiración -->\n              <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-top: 14px; text-align: center;\">\n                <tr>\n                  <td align=\"center\">\n                    <div style=\"display: inline-block; background: rgba(0, 56, 68, 0.6); border: 1px solid #003844; border-radius: 8px; padding: 6px 14px; font-size: 13px; color: #DCDCDD;\">\n                      Copiar código directo: <strong style=\"color: #ffffff; letter-spacing: 2px; font-family: monospace; font-size: 15px; margin-left: 4px;\">{{ $json.code }}</strong>\n                    </div>\n                    <div style=\"font-size: 12px; color: #DCDCDD; opacity: 0.8; margin-top: 10px;\">\n                      ⏱️ <strong>Válido durante 15 minutos</strong> • Código de uso único\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Aviso de Seguridad -->\n              <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background: #003844; border-radius: 10px; padding: 12px 16px; margin: 20px 0 0;\">\n                <tr>\n                  <td style=\"font-size: 12px; color: #ffffff; line-height: 1.5; text-align: center;\">\n                    🛡️ <strong>Seguridad SONAR:</strong> Nunca compartas este código con nadie. El equipo de soporte nunca te solicitará este valor.\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Pie de página -->\n          <tr>\n            <td style=\"background-color: #1C0D1C; border-top: 1px solid rgba(220,220,221,0.15); padding: 22px 28px; text-align: center;\">\n              <p style=\"font-size: 11px; color: #DCDCDD; opacity: 0.7; margin: 0 0 6px;\">\n                Si no solicitaste este registro en SONAR, puedes ignorar este mensaje.\n              </p>\n              <p style=\"font-size: 11px; color: #DCDCDD; opacity: 0.5; margin: 0;\">\n                © 2026 SONAR Music Ecosystem • Midnight Violet & Brick Ember\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
