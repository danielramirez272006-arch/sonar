    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\n// Usar el código enviado por la app o generar uno de 6 dígitos si no viene\nconst code = body.code ? String(body.code) : Math.floor(100000 + Math.random() * 900000).toString();\nconst expiresAt = new Date(Date.now() + 15 * 60 * 1000).toISOString();\n\nreturn [\n  {\n    json: {\n      email,\n      code,\n      expiresAt\n    }\n  }\n];"
      },
