        "subject": "🔑 SONAR - Tu código de recuperación: {{ $json.code }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR - Restablecer Contraseña</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #0c0a09; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f4f4f5;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px; margin: 30px auto; background-color: #18181b; border: 1px solid #27272a; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.6);\">\n    <!-- Header con Logo SONAR -->\n    <tr>\n      <td align=\"center\" style=\"padding: 36px 20px 20px; background: linear-gradient(180deg, rgba(184,12,9,0.18) 0%, rgba(24,24,27,0) 100%);\">\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"display: inline-block;\">\n          <tr>\n            <td style=\"background: #09090b; border: 1px solid #B80C09; border-radius: 50px; padding: 10px 24px; text-align: center;\">\n              <span style=\"display: inline-block; width: 12px; height: 12px; background: #B80C09; border-radius: 50%; margin-right: 8px; vertical-align: middle; box-shadow: 0 0 10px #B80C09;\"></span>\n              <span style=\"font-size: 22px; font-weight: 900; letter-spacing: 4px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n              <span style=\"font-size: 11px; font-weight: 700; color: #f59e0b; letter-spacing: 2px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid #3f3f46; vertical-align: middle;\">RECUPERACIÓN</span>\n            </td>\n          </tr>\n        </table>\n        <h1 style=\"color: #ffffff; font-size: 22px; font-weight: 800; margin: 24px 0 6px;\">Restablecimiento de Contraseña</h1>\n        <p style=\"color: #a1a1aa; font-size: 14px; margin: 0;\">Recibimos una solicitud para acceder nuevamente a tu cuenta.</p>\n      </td>\n    </tr>\n\n    <!-- Contenido Principal -->\n    <tr>\n      <td style=\"padding: 10px 36px 30px;\">\n        <p style=\"font-size: 15px; line-height: 1.6; color: #d4d4d8;\">\n          Ingresa el siguiente <strong>código OTP de 6 dígitos</strong> en la ventana de recuperación de SONAR para definir tu nueva contraseña:\n        </p>\n\n        <!-- Código OTP Box -->\n        <div style=\"text-align: center; margin: 28px 0; padding: 24px 20px; background: #09090b; border: 2px dashed #B80C09; border-radius: 12px;\">\n          <div style=\"font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: #B80C09; margin-bottom: 8px;\">Código de Verificación</div>\n          <div style=\"font-family: 'Courier New', Courier, monospace; font-size: 40px; font-weight: 900; letter-spacing: 12px; color: #ffffff; text-shadow: 0 0 15px rgba(184, 12, 9, 0.6);\">\n            {{ $json.code }}\n          </div>\n          <div style=\"font-size: 12px; color: #71717a; margin-top: 10px;\">Válido durante los próximos 15 minutos</div>\n        </div>\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"background-color: #09090b; border-top: 1px solid #27272a; padding: 24px 36px; text-align: center;\">\n        <p style=\"font-size: 12px; color: #71717a; margin: 0 0 8px;\">\n          Si no solicitaste este código, puedes ignorar este correo de forma segura.\n        </p>\n        <p style=\"font-size: 11px; color: #52525b; margin: 0;\">\n          © 2026 SONAR Music Ecosystem • Seguridad de Cuenta\n        </p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
