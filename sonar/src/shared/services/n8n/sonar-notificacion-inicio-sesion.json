    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-email-log-01",
              "leftValue": "={{ $json.body?.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "log-val-email-002",
      "name": "Validar Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": false,\n  \"message\": \"No se proporcionó un correo válido para la notificación.\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "log-err-003",
      "name": "Respuesta Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst rawName = (body.username || 'Usuario').trim();\nconst username = rawName.includes('@') ? rawName.split('@')[0] : rawName;\nconst device = body.device || 'Navegador Web / Sonar App';\nconst timestamp = body.timestamp || new Date().toISOString();\nconst dateFormatted = new Date(timestamp).toLocaleString('es-ES', { timeZone: 'America/Mexico_City', dateStyle: 'full', timeStyle: 'medium' });\n\nreturn [{\n  json: {\n    email,\n    username,\n    device,\n    timestamp,\n    dateFormatted,\n    subject: `Alerta de seguridad: Inicio de sesión en SONAR`\n  }\n}];"
      },
      "id": "log-prep-004",
      "name": "Formatear Datos de Seguridad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SONAR - Alerta de Inicio de Sesión</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #231123; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #DCDCDD;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #231123; padding: 36px 14px;\">\n    <tr>\n      <td align=\"center\">\n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 540px; background-color: #4B2840; border: 1px solid rgba(220,220,221,0.18); border-radius: 20px; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.6);\">\n          <!-- Cabecera con Isotipo Oficial SONAR -->\n          <tr>\n            <td align=\"center\" style=\"padding: 38px 24px 22px; background: linear-gradient(180deg, rgba(0,56,68,0.35) 0%, rgba(75,40,64,0) 100%);\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 0 auto; text-align: center;\">\n                <tr>\n                  <td align=\"center\" style=\"padding-bottom: 12px;\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 120\" width=\"78\" height=\"78\" fill=\"none\" style=\"display: block; margin: 0 auto;\">\n                      <defs>\n                        <radialGradient id=\"topPetalLog\" cx=\"50%\" cy=\"35%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#9E1B29\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#4A0E18\" stop-opacity=\"0.8\" />\n                        </radialGradient>\n                        <radialGradient id=\"leftPetalLog\" cx=\"35%\" cy=\"50%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#C51613\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#6B0907\" stop-opacity=\"0.8\" />\n                        </radialGradient>\n                        <radialGradient id=\"bottomPetalLog\" cx=\"50%\" cy=\"65%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#1B324B\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#0E1A29\" stop-opacity=\"0.85\" />\n                        </radialGradient>\n                        <radialGradient id=\"rightPetalLog\" cx=\"65%\" cy=\"50%\" r=\"65%\">\n                          <stop offset=\"0%\" stop-color=\"#4B2A5E\" stop-opacity=\"0.9\" />\n                          <stop offset=\"100%\" stop-color=\"#231130\" stop-opacity=\"0.85\" />\n                        </radialGradient>\n                      </defs>\n                      <g>\n                        <circle cx=\"60\" cy=\"38\" r=\"27\" fill=\"url(#topPetalLog)\" />\n                        <circle cx=\"38\" cy=\"60\" r=\"27\" fill=\"url(#leftPetalLog)\" />\n                        <circle cx=\"60\" cy=\"82\" r=\"27\" fill=\"url(#bottomPetalLog)\" />\n                        <circle cx=\"82\" cy=\"60\" r=\"27\" fill=\"url(#rightPetalLog)\" />\n                      </g>\n                      <circle cx=\"60\" cy=\"60\" r=\"37\" stroke=\"rgba(255, 255, 255, 0.45)\" stroke-width=\"1.2\" stroke-dasharray=\"3.5 3.5\" fill=\"none\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"21\" stroke=\"rgba(255, 255, 255, 0.55)\" stroke-width=\"1\" fill=\"none\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"11\" fill=\"#1C0D1C\" stroke=\"rgba(255, 255, 255, 0.25)\" stroke-width=\"1\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"7.5\" fill=\"#B80C09\" />\n                      <circle cx=\"60\" cy=\"60\" r=\"2.8\" fill=\"#ffffff\" />\n                    </svg>\n                  </td>\n                </tr>\n                <tr>\n                  <td align=\"center\">\n                    <div style=\"display: inline-block; background: #231123; border: 1.5px solid #003844; border-radius: 50px; padding: 6px 20px; text-align: center;\">\n                      <span style=\"font-size: 19px; font-weight: 900; letter-spacing: 5px; color: #ffffff; text-transform: uppercase; vertical-align: middle;\">SONAR</span>\n                      <span style=\"font-size: 9px; font-weight: 700; color: #DCDCDD; letter-spacing: 2.5px; text-transform: uppercase; margin-left: 8px; padding-left: 8px; border-left: 1px solid rgba(220,220,221,0.3); vertical-align: middle;\">SEGURIDAD</span>\n                    </div>\n                  </td>\n                </tr>\n              </table>\n              <h1 style=\"color: #ffffff; font-size: 23px; font-weight: 800; margin: 24px 0 6px;\">Inicio de Sesión Confirmado</h1>\n              <p style=\"color: #DCDCDD; font-size: 14px; margin: 0; opacity: 0.9;\">Hola <strong style=\"color: #ffffff;\">{{ $json.username }}</strong>, detectamos un nuevo acceso a tu cuenta.</p>\n            </td>\n          </tr>\n\n          <!-- Ficha de Detalles de Sesión -->\n          <tr>\n            <td style=\"padding: 10px 32px 30px;\">\n              <table width=\"100%\" border=\"0\" cellpadding=\"12\" cellspacing=\"0\" style=\"background: #231123; border: 1px solid rgba(220,220,221,0.15); border-radius: 12px; margin: 16px 0;\">\n                <tr>\n                  <td width=\"32%\" style=\"font-size: 13px; color: #DCDCDD; opacity: 0.8;\">👤 Usuario:</td>\n                  <td style=\"font-size: 13px; color: #ffffff; font-weight: 700;\">{{ $json.username }}</td>\n                </tr>\n                <tr>\n                  <td style=\"font-size: 13px; color: #DCDCDD; opacity: 0.8; border-top: 1px solid rgba(220,220,221,0.08);\">🖥️ Dispositivo:</td>\n                  <td style=\"font-size: 13px; color: #DCDCDD; font-family: monospace; border-top: 1px solid rgba(220,220,221,0.08);\">{{ $json.device }}</td>\n                </tr>\n                <tr>\n                  <td style=\"font-size: 13px; color: #DCDCDD; opacity: 0.8; border-top: 1px solid rgba(220,220,221,0.08);\">⏰ Fecha y Hora:</td>\n                  <td style=\"font-size: 13px; color: #DCDCDD; border-top: 1px solid rgba(220,220,221,0.08);\">{{ $json.dateFormatted }}</td>\n                </tr>\n              </table>\n\n              <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background: #003844; border-radius: 10px; padding: 14px 18px; margin-top: 14px;\">\n                <tr>\n                  <td style=\"font-size: 12px; color: #ffffff; line-height: 1.5;\">\n                    🛡️ <strong>Aviso de Seguridad:</strong> Si fuiste tú, puedes continuar disfrutando de tu música. Si no reconoces este acceso, te recomendamos ingresar a SONAR y cambiar tu contraseña de inmediato.\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Pie de página -->\n          <tr>\n            <td style=\"background-color: #231123; border-top: 1px solid rgba(220,220,221,0.15); padding: 22px 28px; text-align: center;\">\n              <p style=\"font-size: 11px; color: #DCDCDD; opacity: 0.5; margin: 0;\">\n                © 2026 SONAR High-Fidelity Music System • Notificación de Seguridad Automática\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
