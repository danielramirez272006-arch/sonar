      "id": "mod-validate-001",
      "name": "Validar Datos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": false,\n  \"message\": \"Debes proporcionar el contenido de la reseña y su ID.\"\n}",
