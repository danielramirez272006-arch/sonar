    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst rawName = (body.username || 'Melómano').trim();\nconst username = rawName.includes('@') ? rawName.split('@')[0] : rawName;\nconst code = body.code ? String(body.code) : Math.floor(100000 + Math.random() * 900000).toString();\nconst dateFormatted = new Date().toLocaleString('es-ES', { timeZone: 'America/Mexico_City', dateStyle: 'long', timeStyle: 'short' });\n\nreturn [{\n  json: {\n    email,\n    username,\n    code,\n    dateFormatted,\n    subject: `Tu código de activación SONAR: ${code}`\n  }\n}];"
      },
