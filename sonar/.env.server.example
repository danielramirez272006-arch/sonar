# Copiar a .env.server.local. Solo lo lee el servidor; nunca usar prefijo VITE_.
SONAR_ADMIN_EMAIL=admin@sonar.local
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SONAR_AGENT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
# Mismo client ID publico que utiliza el boton de Google, si se usa.
GOOGLE_CLIENT_ID=
SONAR_APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
